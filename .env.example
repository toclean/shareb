# Copy this to .env and fill in the values
# cp .env.example .env

# REQUIRED: Change this to a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-something-long-and-random

# Directory inside the container where the DB and uploads are stored.
# Matches the volume mount in docker-compose.yml (./data:/data)
DATA_DIR=/data

# The public URL of your app (used for CORS). Set to your domain or IP.
# Example: https://shareb.yourdomain.com  or  http://123.45.67.89:3001
CLIENT_ORIGIN=https://your-app-url-here

# Where the pre-built React app lives (set automatically by the Dockerfile)
CLIENT_BUILD_DIR=/app/client/dist

NODE_ENV=production
PORT=3001
